# Netlify Functions / local Netlify CLI
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
STUDENT_SESSION_COOKIE=student_session

# Resend daily email service
RESEND_API_KEY=re_replace-with-send-only-key
RESEND_FROM_EMAIL=日报系统 <report@maildr.example.com>

# SMTP daily email service (本地 SMTP 发件，例如 QQ 邮箱)
# 留空则本地模式回退为落盘预览；RESEND_API_KEY 与 SMTP_* 同时配置时优先 Resend
#SMTP_HOST=smtp.qq.com
#SMTP_PORT=465
#SMTP_SECURE=true
#SMTP_USER=your-mail@qq.com
#SMTP_PASS=授权码（QQ邮箱：设置→账户→开启IMAP/SMTP服务→生成授权码）
#SMTP_FROM=日报系统 <your-mail@qq.com>

# Bootstrap script only
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
BOOTSTRAP_ADMIN_NAME=系统管理员

# Local preview mode
#LOCAL_ADMIN_PASSWORD=local-admin-123
#LOCAL_SQLITE_DB=instance/local-preview.sqlite3
